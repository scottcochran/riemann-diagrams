# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Graphviz source files the Python package writes before rendering; a successful
# run deletes them (cleanup=True), a failed one leaves them beside the output
graphs/riemann_*.gv
graphs/riemann_depth[0-9]*
!graphs/riemann_depth[0-9]*.png
!graphs/riemann_depth[0-9]*.svg
graphs/riemann_trace*
!graphs/riemann_trace*.png
graphs/riemann_chapters
graphs/riemann_full
!graphs/riemann_full.dot
!graphs/riemann_full.svg

# macOS and editors
.DS_Store
.vscode/
.idea/

# Lean build output of tools/lean-edges (the deps reader)
tools/lean-edges/.lake/
